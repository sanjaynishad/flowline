---
import { SITE } from '../consts'

interface Props {
  name: string
  alt: string
  loading?: 'eager' | 'lazy'
}

const { name, alt, loading = 'lazy' } = Astro.props
const base = `${SITE.base}/screenshots/${name}`
---

<img
  src={`${base}-dark.png`}
  data-shot={base}
  alt={alt}
  width="2880"
  height="1800"
  loading={loading}
  decoding="async"
  class="w-full"
/>
