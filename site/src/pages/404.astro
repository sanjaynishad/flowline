---
import Base from '../layouts/Base.astro'
import { href } from '../consts'
---

<Base title="Page not found" noindex={true}>
  <div class="mx-auto max-w-content px-5 py-28 text-center">
    <p class="font-mono text-sm text-primary">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-fg">This page drifted off-task</h1>
    <p class="mx-auto mt-3 max-w-md text-muted">
      The page you're looking for doesn't exist. Let's get you back into flow.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={href('/')} class="rounded-xl bg-primary px-6 py-3 font-semibold text-on-primary">
        Back home
      </a>
      <a
        href={href('/docs')}
        class="rounded-xl border border-border bg-surface/60 px-6 py-3 font-semibold text-fg hover:border-primary/50"
      >
        Read the docs
      </a>
    </div>
  </div>
</Base>
