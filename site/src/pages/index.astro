---
import Base from '../layouts/Base.astro'
import Shot from '../components/Shot.astro'
import { SITE, href } from '../consts'
import { HOME_DESCRIPTION, softwareJsonLd } from '../seo'

const features = [
  {
    icon: 'bolt',
    title: 'Automatic app tracking',
    body: 'Windows tells Flowline when the foreground window changes. No start/stop timer, and no constant polling loop.'
  },
  {
    icon: 'public',
    title: 'Browser time by domain',
    body: 'An optional Chrome or Edge extension reports the active tab, so time lands on github.com or youtube.com instead of one Chrome bucket.'
  },
  {
    icon: 'category',
    title: 'Rules you can edit',
    body: 'About 80 default rules tag activity as productive, neutral, or distracting. Match an app, a domain, or a window-title keyword.'
  },
  {
    icon: 'insights',
    title: 'Dashboard and insights',
    body: 'Deep-work total, distraction time, context switches, a time-allocation ring, top apps, and a live activity stream.'
  },
  {
    icon: 'timer',
    title: 'Pomodoro focus blocks',
    body: 'Start a 15, 25, or 50 minute block from the tray or the Sessions page. Break reminders are included.'
  },
  {
    icon: 'local_fire_department',
    title: 'Daily goal and streak',
    body: 'Set a deep-work target. Flowline tracks the streak and shows the last 7 days.'
  },
  {
    icon: 'bedtime',
    title: 'Idle time excluded',
    body: 'If you walk away, that stretch is not counted. The idle threshold is adjustable.'
  },
  {
    icon: 'download',
    title: 'CSV and JSON export',
    body: 'Activity sits in a local SQLite file. Export it, or delete the database when you want a clean slate.'
  }
]

const steps = [
  {
    n: '01',
    title: 'Install and leave it running',
    body: 'The tray icon keeps tracking after you close the window. Launch on login is optional.'
  },
  {
    n: '02',
    title: 'Rules label the time',
    body: 'Each switch is matched to productive, neutral, or distracting. Edit a rule when the default is wrong.'
  },
  {
    n: '03',
    title: 'Read the day on your PC',
    body: 'The dashboard and Insights page show where the hours went. Nothing is uploaded to build that view.'
  }
]

const audiences = [
  {
    title: 'Developers',
    body: 'See how much of the day was the editor, the terminal, docs, and chat, without a timer you forget to start.'
  },
  {
    title: 'Writers and designers',
    body: 'Separate deep-work apps from the tabs that eat the afternoon. The weekly view shows whether the goal held.'
  },
  {
    title: 'Students',
    body: 'Track study apps and browser research on a personal PC. This is self-tracking, not a tool for someone else to watch you.'
  }
]
---

<Base description={HOME_DESCRIPTION} jsonLd={softwareJsonLd()}>
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-content px-5 pb-10 pt-16 sm:pt-24">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1 font-mono text-xs text-muted"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
          {SITE.tagline}
        </span>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-fg sm:text-5xl">
          Automatic time tracker for Windows
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">
          Flowline logs the app in front of you, and the browser tab when the extension is
          connected. It tags that time as productive, neutral, or distracting, then shows it on a
          local dashboard. No account. The database stays on your PC.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a
            href={href('/download')}
            class="rounded-xl bg-primary px-6 py-3 font-semibold text-on-primary shadow-glow transition-transform hover:-translate-y-0.5"
          >
            Download for Windows
          </a>
          <a
            href={href('/compare')}
            class="rounded-xl border border-border bg-surface/60 px-6 py-3 font-semibold text-fg hover:border-primary/50"
          >
            Compare alternatives
          </a>
        </div>
        <p class="mt-4 font-mono text-xs text-muted">
          Free and MIT licensed. Windows 10 and 11 only. Not a website blocker.
        </p>
      </div>

      <div class="relative mx-auto mt-14 max-w-5xl">
        <div
          class="overflow-hidden rounded-2xl border border-border bg-bg-soft shadow-glow ring-1 ring-primary/10"
        >
          <Shot
            name="dashboard"
            alt="Flowline dashboard showing deep-work total, distraction time, a time-allocation ring, and top applications"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="mx-auto max-w-content px-5 py-16">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-fg">
        App tracking, browser domains, and focus blocks
      </h2>
      <p class="mt-3 text-muted">
        The tracker runs on its own. Sessions, goals, and alerts are there when you want to act on
        the numbers.
      </p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f) => (
          <div class="rounded-xl border border-border bg-surface/40 p-5 transition-colors hover:border-primary/40">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/15 text-primary">
              <span class="material-symbols-outlined" aria-hidden="true">
                {f.icon}
              </span>
            </span>
            <h3 class="mt-4 font-semibold text-fg">{f.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-border/60 bg-bg-soft/40">
    <div class="mx-auto max-w-content px-5 py-16">
      <h2 class="text-3xl font-semibold tracking-tight text-fg">Who it is for</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Personal desk work on your own Windows PC. Flowline is not built for employers, classrooms,
        or parents monitoring someone else.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          audiences.map((item) => (
            <div class="rounded-xl border border-border bg-surface/40 p-5">
              <h3 class="text-lg font-semibold text-fg">{item.title}</h3>
              <p class="mt-2 text-sm text-muted">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-content px-5 py-16">
    <h2 class="text-3xl font-semibold tracking-tight text-fg">How automatic tracking works</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((s) => (
          <div>
            <span class="font-mono text-sm text-primary">{s.n}</span>
            <h3 class="mt-2 text-xl font-semibold text-fg">{s.title}</h3>
            <p class="mt-2 text-muted">{s.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-sm text-muted">
      The longer version, including the local WebSocket bridge, is in
      <a href={href('/docs/how-it-works')} class="font-semibold text-primary hover:text-primary-strong">
        how it works
      </a>.
    </p>
  </section>

  <section class="border-y border-border/60 bg-bg-soft/40">
    <div class="mx-auto max-w-content px-5 py-16">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold tracking-tight text-fg">
          Insights, Pomodoro sessions, and rules
        </h2>
        <p class="mt-3 text-muted">
          Insights charts the day. Sessions holds the focus blocks and the weekly report. Rules is
          where a miscategorized app gets fixed.
        </p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl border border-border bg-bg-soft">
          <Shot
            name="insights"
            alt="Flowline Insights page with an intra-day focus chart and categorized application breakdown"
          />
          <figcaption class="border-t border-border px-4 py-3 text-sm text-muted">
            Insights: focus across the day, plus apps grouped by category
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-border bg-bg-soft">
          <Shot
            name="sessions"
            alt="Flowline Focus Sessions page showing Pomodoro-style blocks and a weekly report"
          />
          <figcaption class="border-t border-border px-4 py-3 text-sm text-muted">
            Focus sessions: 15, 25, or 50 minute blocks, goals, and streaks
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-content px-5 py-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-fg">Local database, no account</h2>
      <p class="mt-4 text-muted">
        There is no Flowline server to sync with. Activity is a SQLite file under your user
        profile. The app does not record the screen, log keystrokes, or block websites. A
        distraction alert is a notification, not a lock.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm font-semibold">
        <a href={href('/docs/privacy')} class="text-primary hover:text-primary-strong">
          Privacy details
        </a>
        <a href={href('/compare')} class="text-primary hover:text-primary-strong">
          Flowline vs RescueTime and ActivityWatch
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-content px-5 pb-20">
    <div
      class="rounded-3xl border border-primary/30 bg-gradient-to-b from-surface/60 to-bg-soft/60 p-10 text-center shadow-glow"
    >
      <h2 class="text-3xl font-semibold tracking-tight text-fg">Install the Windows tracker</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Grab the installer, or build it from source. Tracking starts on launch. The browser
        extension is optional.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href={href('/download')}
          class="rounded-xl bg-primary px-6 py-3 font-semibold text-on-primary transition-transform hover:-translate-y-0.5"
        >
          Download for Windows
        </a>
        <a
          href={href('/docs/installation')}
          class="rounded-xl border border-border bg-surface/60 px-6 py-3 font-semibold text-fg hover:border-primary/50"
        >
          Installation guide
        </a>
      </div>
    </div>
  </section>
</Base>
