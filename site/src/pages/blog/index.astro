---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { href } from '../../consts'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<Base
  title="Blog"
  description="Guides on automatic Windows time tracking, local-first alternatives, and a Pomodoro setup that does not need a cloud account."
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-4xl font-bold tracking-tight text-fg">Flowline blog</h1>
    <p class="mt-3 text-muted">
      Setup notes and comparisons for the Windows tracker. Product docs live in the
      <a href={href('/docs')} class="text-primary hover:text-primary-strong">documentation</a>.
    </p>

    <div class="mt-10 space-y-8">
      {
        posts.map((post) => (
          <article class="border-b border-border/60 pb-8">
            <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-muted">
              {fmt(post.data.date)}
            </time>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight">
              <a href={href(`/blog/${post.id}`)} class="text-fg hover:text-primary">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-muted">{post.data.description}</p>
            <a
              href={href(`/blog/${post.id}`)}
              class="mt-3 inline-block text-sm font-semibold text-primary hover:text-primary-strong"
            >
              Read more
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Base>
