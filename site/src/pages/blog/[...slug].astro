---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { href } from '../../consts'
import { blogPostingJsonLd, breadcrumbJsonLd } from '../../seo'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: entry.data.title, path: `/blog/${entry.id}` }
  ]),
  blogPostingJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    id: entry.id
  })
]
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-5 py-12">
    <a href={href('/blog')} class="font-mono text-xs text-muted hover:text-fg">← All posts</a>
    <time datetime={entry.data.date.toISOString()} class="mt-6 block font-mono text-xs text-muted">
      {fmt(entry.data.date)}
    </time>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-fg">{entry.data.title}</h1>
    <div class="prose-flow mt-8">
      <Content />
    </div>
  </article>
</Base>
