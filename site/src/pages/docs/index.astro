---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import DocsSidebar from '../../components/DocsSidebar.astro'
import { href } from '../../consts'

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order)
---

<Base
  title="Documentation"
  description="Install Flowline on Windows, add per-site browser tracking, edit categorization rules, and read how the local time tracker stores data."
>
  <div class="mx-auto max-w-content gap-10 px-5 py-10 lg:grid lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <DocsSidebar />
      </div>
    </aside>
    <div class="min-w-0 max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight text-fg">Flowline documentation</h1>
      <p class="mt-3 text-muted">
        Install the Windows app, connect the browser extension, and tune rules and goals. If you
        are choosing a tracker first, start with the
        <a href={href('/compare')} class="text-primary hover:text-primary-strong">comparison</a>
        or the
        <a href={href('/faq')} class="text-primary hover:text-primary-strong">FAQ</a>.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          docs.map((doc) => (
            <a
              href={href(`/docs/${doc.id}`)}
              class="rounded-xl border border-border bg-surface/40 p-5 transition-colors hover:border-primary/40"
            >
              <h2 class="font-semibold text-fg">{doc.data.title}</h2>
              <p class="mt-1.5 text-sm text-muted">{doc.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>
